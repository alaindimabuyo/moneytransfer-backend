# Server
PORT=4000
NODE_ENV=development

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://mtq:mtq_dev_password@localhost:5433/mtq

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=mtq_session

# CORS / cookies
FRONTEND_ORIGIN=http://localhost:3000

# ExchangeRate-API: get a free key at https://www.exchangerate-api.com/
# Free tier: 1,500 requests/month
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_TTL_MINUTES=5

# Google SSO (optional). To enable:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID, type "Web application"
#   3. Add http://localhost:3000 to "Authorized JavaScript origins"
#   4. Copy the Client ID here AND into frontend/.env.local
GOOGLE_CLIENT_ID=
